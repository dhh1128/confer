# confer configuration — copy to .env and fill in real values.
# .env is gitignored; never commit a real bot token.

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Your Discord user ID (Discord snowflake, 18-19 digits).
# To find it: Discord → Settings → Advanced → enable Developer Mode,
# then right-click your name → Copy User ID.
CONFER_USER_ID=
