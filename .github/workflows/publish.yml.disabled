# ░░░ DISABLED — DO NOT RE-ENABLE WITHOUT OWNER AUTHORIZATION ░░░
# This file is intentionally named *.disabled so GitHub does NOT load it as a
# workflow: it cannot trigger on any event. Automated PyPI publishing was
# never authorized by the owner (this.i: Automated PyPI Publishing Disabled
# Until Owner Authorizes, pn7qvk4x). To re-enable, the owner must (per
# pn7qvk4x): decide the code is mature, claim an AVAILABLE PyPI name (the bare
# `confer` name is taken by an unrelated project), complete the trusted-
# publisher + `pypi` environment setup below, address DevOps F1 (SHA-pin the
# pypa publish action — currently @release/v1, a mutable branch) and F2 (add a
# CI test gate before publish), THEN rename this file back to publish.yml.
#
# Publish confer to PyPI on a version tag (PyPI Trusted Publishing, pp4nqvx7).
#
# This uses PyPI's OIDC "trusted publisher" flow — no API token/secret is
# stored in the repo. Before the first run, daniel must do the OUTWARD-FACING
# one-time setup (the workflow cannot and should not do it automatically):
#   1. Confirm the `confer` project name is available on PyPI.
#   2. On PyPI, add a trusted publisher for this repo:
#      owner=dhh1128, repo=confer, workflow=publish.yml, environment=pypi.
#   3. Create the `pypi` environment in the repo settings (optional gate).
# Then publishing happens by pushing a tag, e.g.:  git tag v0.1.0 && git push origin v0.1.0
name: Publish

on:
  push:
    tags: ["v*"]

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    environment: pypi
    permissions:
      id-token: write  # required for PyPI trusted publishing (OIDC)
    steps:
      - name: Checkout
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
        with:
          persist-credentials: false

      - name: Install uv
        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39  # v8.2.0

      - name: Build sdist and wheel
        run: uv build

      - name: Publish to PyPI
        uses: pypa/gh-action-pypi-publish@cef221092ed1bacb1cc03d23a2d87d1d172e277b  # release/v1
