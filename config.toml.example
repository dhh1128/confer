# confer daemon configuration
# Copy this file to ~/.config/confer/config.toml and fill in real values.
# Permissions: chmod 600 ~/.config/confer/config.toml

# Discord bot token from https://discord.com/developers/applications
discord_bot_token = ""

# Your Discord user ID (snowflake, 18-19 digits).
# Discord → Settings → Advanced → enable Developer Mode,
# then right-click your name → Copy User ID.
confer_user_id = 0

# Optional [ask] tunables (operator-level; agents do not see these).
# Cadence of "still waiting on your answer to: ..." re-ping DMs while an
# ask is in flight. Default 900 (15 min). Smaller values nag more often.
# [ask]
# re_ping_every_seconds = 900
